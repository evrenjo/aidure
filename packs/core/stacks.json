{
  "note": "스택 목록 : repo 를 보고 스택을 감지하는 조건. layer = 서버(backend)·클라이언트(frontend=웹·desktop·mobile·watch·tv)·db · 인프라(infra: 컨테이너 · Kubernetes · IaC). parent 가 있으면 그 프레임워크의 세부(예: spring-webflux). 전용 팩(pack)이 있으면 그 팩이, 없으면 layer 공통 팩만(있으면) 붙는다.",
  "stacks": [
    {
      "id": "spring",
      "label": "Spring",
      "layer": "backend",
      "detect": [
        {
          "files": [
            "build.gradle",
            "build.gradle.kts",
            "pom.xml",
            "libs.versions.toml"
          ],
          "contains": "spring-boot|org\\.springframework|libs\\.plugins\\.spring\\.boot"
        },
        {
          "files": [
            "application.properties",
            "application.yml",
            "application.yaml",
            "application-*.properties",
            "application-*.yml",
            "application-*.yaml"
          ],
          "contains": "^spring(\\.[a-z]|:)"
        },
        {
          "files": [
            "*.java",
            "*.kt"
          ],
          "contains": "@SpringBootApplication",
          "depth": 9
        }
      ],
      "note": "기존 항목 수정안. 기존 정규식은 Kotlin DSL(id(\"org.springframework.boot\"))·Maven parent(<groupId>org.springframework.boot)를 이미 잡는다. 빠지는 경우는 버전 카탈로그 — build.gradle.kts 에 alias(libs.plugins.spring.boot) 만 있고 좌표는 gradle/libs.versions.toml 에 있을 때. files 에 libs.versions.toml 추가 + libs.plugins.spring.boot 대안. 기존 pack: stack-spring 은 그대로 둔다.",
      "pack": "stack-spring"
    },
    {
      "id": "fastapi",
      "label": "FastAPI",
      "layer": "backend",
      "detect": [
        {
          "files": [
            "pyproject.toml",
            "requirements*.txt",
            "Pipfile"
          ],
          "contains": "fastapi"
        }
      ],
      "pack": "stack-fastapi"
    },
    {
      "id": "django",
      "label": "Django",
      "layer": "backend",
      "detect": [
        {
          "files": [
            "manage.py"
          ]
        },
        {
          "files": [
            "pyproject.toml",
            "requirements*.txt",
            "Pipfile"
          ],
          "contains": "(^|[\"'\\s])django([\"'\\s=<>~]|$)"
        }
      ],
      "pack": "stack-django"
    },
    {
      "id": "flask",
      "label": "Flask",
      "layer": "backend",
      "detect": [
        {
          "files": [
            "pyproject.toml",
            "requirements*.txt",
            "Pipfile"
          ],
          "contains": "(^|[\"'\\s])flask([\"'\\s=<>~]|$)"
        }
      ]
    },
    {
      "id": "express",
      "label": "Express",
      "layer": "backend",
      "detect": [
        {
          "files": [
            "package.json"
          ],
          "contains": "\"express\"\\s*:"
        }
      ]
    },
    {
      "id": "nestjs",
      "label": "NestJS",
      "layer": "backend",
      "detect": [
        {
          "files": [
            "package.json"
          ],
          "contains": "\"@nestjs/core\""
        }
      ],
      "pack": "stack-nestjs"
    },
    {
      "id": "aspnet",
      "label": "ASP.NET",
      "layer": "backend",
      "detect": [
        {
          "files": [
            "*.csproj"
          ],
          "contains": "Microsoft\\.AspNetCore|Sdk=\"Microsoft\\.NET\\.Sdk\\.Web\""
        }
      ]
    },
    {
      "id": "go",
      "label": "Go",
      "layer": "backend",
      "detect": [
        {
          "files": [
            "go.mod"
          ]
        }
      ]
    },
    {
      "id": "react",
      "label": "React",
      "layer": "frontend",
      "pack": "stack-react",
      "detect": [
        {
          "files": [
            "package.json"
          ],
          "contains": "\"react\"\\s*:"
        }
      ]
    },
    {
      "id": "nextjs",
      "label": "Next.js",
      "layer": "frontend",
      "parent": "react",
      "pack": "stack-nextjs",
      "detect": [
        {
          "files": [
            "package.json"
          ],
          "contains": "\"next\"\\s*:\\s*\"(?:[~^<>=]*\\d|latest|canary|next|workspace:|\\*)"
        },
        {
          "files": [
            "next.config.js",
            "next.config.mjs",
            "next.config.ts"
          ]
        }
      ],
      "note": "React 의 세부 프레임워크. stack-react 와 stack-nextjs 가 함께 붙는다"
    },
    {
      "id": "angular",
      "label": "Angular",
      "layer": "frontend",
      "detect": [
        {
          "files": [
            "angular.json"
          ]
        },
        {
          "files": [
            "package.json"
          ],
          "contains": "\"@angular/core\""
        }
      ]
    },
    {
      "id": "vue",
      "label": "Vue",
      "layer": "frontend",
      "detect": [
        {
          "files": [
            "package.json"
          ],
          "contains": "\"vue\"\\s*:"
        }
      ]
    },
    {
      "id": "svelte",
      "label": "Svelte",
      "layer": "frontend",
      "detect": [
        {
          "files": [
            "package.json"
          ],
          "contains": "\"svelte\"\\s*:"
        }
      ]
    },
    {
      "id": "postgres",
      "label": "PostgreSQL",
      "layer": "db",
      "pack": "stack-postgres",
      "detect": [
        {
          "files": [
            "application*.yml",
            "application*.yaml",
            "application*.properties",
            ".env*",
            "docker-compose*.yml",
            "docker-compose*.yaml",
            "compose*.yml",
            "pyproject.toml",
            "requirements*.txt",
            "package.json",
            "build.gradle",
            "build.gradle.kts",
            "pom.xml",
            "*.csproj",
            "go.mod",
            "settings.py"
          ],
          "contains": "jdbc:postgresql|postgres(ql)?://|psycopg|asyncpg|\"pg\"\\s*:|org\\.postgresql|Npgsql|jackc/pgx|lib/pq|image:\\s*postgres"
        }
      ]
    },
    {
      "id": "mysql",
      "label": "MySQL·MariaDB",
      "layer": "db",
      "detect": [
        {
          "files": [
            "application*.yml",
            "application*.yaml",
            "application*.properties",
            ".env*",
            "docker-compose*.yml",
            "docker-compose*.yaml",
            "compose*.yml",
            "pyproject.toml",
            "requirements*.txt",
            "package.json",
            "build.gradle",
            "build.gradle.kts",
            "pom.xml",
            "*.csproj",
            "go.mod",
            "settings.py"
          ],
          "contains": "jdbc:(mysql|mariadb)|mysql://|mariadb://|pymysql|mysqlclient|\"mysql2?\"\\s*:|mysql-connector|mariadb-java-client|Pomelo\\.EntityFrameworkCore\\.MySql|image:\\s*(mysql|mariadb)"
        }
      ]
    },
    {
      "id": "oracle",
      "label": "Oracle",
      "layer": "db",
      "detect": [
        {
          "files": [
            "application*.yml",
            "application*.yaml",
            "application*.properties",
            ".env*",
            "pyproject.toml",
            "requirements*.txt",
            "package.json",
            "build.gradle",
            "build.gradle.kts",
            "pom.xml",
            "*.csproj"
          ],
          "contains": "jdbc:oracle|ojdbc|cx_Oracle|oracledb|Oracle\\.ManagedDataAccess"
        }
      ]
    },
    {
      "id": "mssql",
      "label": "SQL Server",
      "layer": "db",
      "detect": [
        {
          "files": [
            "application*.yml",
            "application*.yaml",
            "application*.properties",
            ".env*",
            "docker-compose*.yml",
            "pyproject.toml",
            "requirements*.txt",
            "package.json",
            "build.gradle",
            "build.gradle.kts",
            "pom.xml",
            "*.csproj",
            "appsettings*.json"
          ],
          "contains": "jdbc:sqlserver|mssql-jdbc|pyodbc|pymssql|\"mssql\"\\s*:|\"tedious\"\\s*:|Microsoft\\.EntityFrameworkCore\\.SqlServer|Server=.*Database="
        }
      ]
    },
    {
      "id": "mongodb",
      "label": "MongoDB",
      "layer": "db",
      "detect": [
        {
          "files": [
            "application*.yml",
            "application*.yaml",
            "application*.properties",
            ".env*",
            "docker-compose*.yml",
            "pyproject.toml",
            "requirements*.txt",
            "package.json",
            "build.gradle",
            "build.gradle.kts",
            "pom.xml",
            "go.mod"
          ],
          "contains": "mongodb(\\+srv)?://|spring-boot-starter-data-mongodb|pymongo|motor|\"mongoose\"\\s*:|\"mongodb\"\\s*:|mongo-driver|image:\\s*mongo"
        }
      ]
